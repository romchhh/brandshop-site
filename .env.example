# Public storefront URL (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://site.brandshop.in.ua

# Protect /api/cron/sync in production (Vercel Cron sends Bearer automatically).
CRON_SECRET=change-me

# Nova Poshta directory API (cities / warehouses). Optional for getCities/getWarehouses.
NOVA_POSHTA_API_KEY=
# NEXT_PUBLIC_NOVA_POSHTA_API_KEY=

# Telegram: усі замовлення в групу
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
